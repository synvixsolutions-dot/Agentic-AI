# Copy to .env.local for local testing, and add the same keys in
# Vercel > Project > Settings > Environment Variables for the live site.

RESEND_API_KEY=re_your_key_here

# Inbox that receives Contact form messages.
# TODO: replace with the official club inbox once it is confirmed.
CONTACT_TO=club-inbox@example.com

# Optional. Leave unset until the club has a verified sending domain in Resend.
# CONTACT_FROM=Agentic AI Club <hello@your-domain.com>
